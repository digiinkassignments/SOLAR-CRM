PORT=5000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=solar_crm

JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Super Admin ke liye alag JWT secret (optional but recommended)
SUPER_ADMIN_JWT_SECRET=your_super_admin_jwt_secret_here

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_app_password
MAIL_FROM="Solar CRM <your_email@gmail.com>"

# Public website signup only; existing CRM login does not depend on Redis.
REDIS_URL=redis://127.0.0.1:6379
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TRIAL_OTP_SECRET=
TRIAL_REDIS_PREFIX=solops:public-trial:v2:
# Keep false until both real Cloudflare keys are configured.
PUBLIC_TRIAL_TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
